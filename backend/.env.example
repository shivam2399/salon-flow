PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=salon-flow
DB_USER=root
DB_PASSWORD=your_mysql_password

# Authentication & Seeds
SEED_DEMO_PASSWORD=ChangeThisForLocalDemo123!
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=1h
SALON_SLUG=salonflow-demo

# Razorpay Payment Gateway Integration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional Email / Notification Service (SendGrid or SMTP)
# If empty, Ethereal test inbox is automatically used for dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="SalonFlow" <no-reply@salonflow.com>

# Optional Stripe Integration
STRIPE_SECRET_KEY=sk_test_mock_stripe_key_salonflow
