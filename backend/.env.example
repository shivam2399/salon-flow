PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=salon-flow
DB_USER=root
DB_PASSWORD=your_mysql_password

# Authentication & Seeds
SEED_DEMO_PASSWORD=ChangeThisForLocalDemo123!
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=1h
SALON_SLUG=salonflow-demo

# Razorpay Payment Gateway Integration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Notification Service (SendGrid or Gmail / Custom SMTP)
# If empty, a simulated Ethereal test inbox is automatically used for local testing
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.your_sendgrid_api_key_here
SMTP_SECURE=false
EMAIL_FROM="SalonFlow Studio" <no-reply@yourverifieddomain.com>

# Twilio SMS Notification Service (Optional)
# If empty, SMS dispatches are safely simulated in backend logs
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Optional Stripe Integration (Alternative to Razorpay)
STRIPE_SECRET_KEY=sk_test_mock_stripe_key_salonflow
